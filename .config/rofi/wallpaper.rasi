/*****----- Wallpaper Picker Theme (Catppuccin Mocha) -----*****/

configuration {
    show-icons:                 true;
}

@import "colors.rasi"

/*****----- Main Window (Compact Popup, No Searchbar, No Text Labels) -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       850px;

    enabled:                     true;
    border:                      1px solid;
    border-color:                @border-col;
    border-radius:               16px;
    cursor:                      "default";
    background-color:            @background;
    padding:                     15px;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     12px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements (Thumbnail Images Only - Catppuccin Mauve Highlight) -----*****/
element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0px;
    margin:                      0px;
    padding:                     8px;
    border-radius:               12px;
    background-color:            transparent;
    cursor:                      pointer;
    children:                    [ "element-icon" ];
}

element normal.normal {
    background-color:            transparent;
}

element selected.normal {
    background-color:            rgba(203, 166, 247, 0.25);
    border:                      2px solid;
    border-color:                rgba(203, 166, 247, 0.85);
}

element-icon {
    background-color:            transparent;
    size:                        140px;
    cursor:                      inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               8px;
}

element-text {
    enabled:                     false;
}
