[Unit]
Description=Cherry shell daemon
# No longer needs After=graphical-session.target for startup-ordering
# purposes  -  socket activation means this service only ever starts in
# response to the first incoming connection on cherry-daemon.socket,
# so ordering relative to the graphical session no longer matters the
# same way. Kept anyway as a sane logical dependency.
After=graphical-session.target cherry-daemon.socket
Requires=cherry-daemon.socket

[Service]
Type=simple
WorkingDirectory=%h/.config/cherry/daemon
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=1s
KillMode=mixed

# No [Install] section  -  this unit is no longer enabled directly.
# Only cherry-daemon.socket gets `systemctl --user enable`d; systemd
# starts THIS service automatically (same basename convention) the
# first time a client connects to the socket.
