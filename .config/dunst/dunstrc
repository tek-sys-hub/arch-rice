[global]
    ### Display ###
    monitor = 0
    follow = none

    # Geometry
    width = (200, 360)
    height = 150
    origin = bottom-center
    offset = 0x24
    scale = 0

    # Notification stacking
    notification_limit = 4
    gap_size = 6

    ### Appearance (Catppuccin Mocha) ###
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 360
    progress_bar_corner_radius = 2
    progress_bar_corners = all
    icon_corner_radius = 6
    icon_corners = all
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#c6a0f6"
    gap_size = 6
    separator_color = frame
    sort = yes

    ### Text ###
    font = JetBrainsMono Nerd Font 10.5
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 40

    ### History ###
    sticky_history = no
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    corners = all
    ignore_dbusclose = false

    ### Wayland ###
    layer = overlay
    force_xwayland = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true

[urgency_low]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#c6a0f6"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#c6a0f6"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#c6a0f6"
    timeout = 0
    default_icon = dialog-warning
